""", unsafe_allow_html=True)

st.markdown('<div class="main-header">🧠 MOODMETRICS</div>', unsafe_allow_html=True)
st.markdown(
    '<div class="sub-header">Instrumento de Avaliação do Espectro do Humor<br>'
    "Versão · 72 itens + filtros dinâmicos de prejuízo funcional</div>",
    unsafe_allow_html=True,
)

# Sidebar
with st.sidebar:
    st.header("📋 Instruções")
    st.markdown("""
    - Considere períodos de **3–5 dias** ou mais.
    - Responda **Sim** ou **Não** em cada pergunta.
    - Nenhuma opção vem pré-selecionada — é obrigatório escolher.
    - Os **filtros** não pontuam; avaliam prejuízo funcional.
    - O filtro de cada bloco só aparece se houver pelo menos um **Sim**.
    """)
    st.divider()
    st.header("📚 Bibliografia")
    pasta_citacoes = st.text_input(
        "Pasta das citações (.txt)",
        value=str(DEFAULT_CITACOES),
        help="Ex.: .../projeto_artigos/05_citacoes",
    )
    n_cit = len(list(Path(pasta_citacoes).glob("*.txt"))) if Path(pasta_citacoes).exists() else 0
    if n_cit:
        st.caption(f"Citações encontradas: **{n_cit}** arquivo(s)")
    else:
        st.caption("Pasta de citações não encontrada (bibliografia será omitida).")
    st.caption("MOODMETRICS • Pesquisa científica")

# Session state
if "respostas" not in st.session_state:
    st.session_state.respostas = {}
if "current_idx" not in st.session_state:
    st.session_state.current_idx = 0
if "finished" not in st.session_state:
    st.session_state.finished = False
if "sequencia" not in st.session_state:
    st.session_state.sequencia = construir_sequencia()

SEQUENCIA = st.session_state.sequencia
TOTAL_SLOTS = len(SEQUENCIA)

# ============================================================
# WIZARD (única forma de preenchimento)
# ============================================================

if not st.session_state.finished:
    # Avança automaticamente filtros que não se aplicam (0 sintomas)
    while st.session_state.current_idx < TOTAL_SLOTS:
        slot = SEQUENCIA[st.session_state.current_idx]
        if slot["tipo"] == "filtro":
            texto_f = gerar_texto_filtro(slot["bloco"], st.session_state.respostas)
            if texto_f is None:
                st.session_state.respostas[slot["codigo"]] = 0
                st.session_state.current_idx += 1
                continue
        break

    if st.session_state.current_idx >= TOTAL_SLOTS:
        st.session_state.finished = True
        st.rerun()

    progress = st.session_state.current_idx / TOTAL_SLOTS
    st.progress(progress, text=f"Passo {st.session_state.current_idx + 1} de {TOTAL_SLOTS}")

    slot = SEQUENCIA[st.session_state.current_idx]
    is_filter = slot["tipo"] == "filtro"
    codigo = slot["codigo"]
    secao = slot["nome_secao"]

    st.markdown(f"**Seção:** {secao}")

    if is_filter:
        texto = gerar_texto_filtro(slot["bloco"], st.session_state.respostas)
        if texto is None:
            st.session_state.respostas[codigo] = 0
            st.session_state.current_idx += 1
            st.rerun()
        st.markdown(f"""
        <div class="filter-box">
            <h4>[{codigo}] Filtro de Prejuízo Funcional</h4>
            <p style="font-size:1.15rem; line-height:1.5;">{texto}</p>
        </div>
        """, unsafe_allow_html=True)
    else:
        item = ITEMS[codigo]
        if codigo in ("CD46", "CD47", "CD48"):
            st.markdown("""
            <div class="ethics-box">
                <strong>Aviso importante:</strong> As próximas perguntas tratam de pensamentos ou comportamentos
                relacionados a morte e suicídio. Se você estiver em sofrimento, procure ajuda imediatamente
                (CVV 188 no Brasil — 24h, gratuito e sigiloso).
            </div>
            """, unsafe_allow_html=True)
        st.markdown(f"""
        <div class="question-box">
            <h4>[{codigo}] {item['label']}</h4>
            <p style="font-size:1.1rem;">{item['texto']}</p>
        </div>
        """, unsafe_allow_html=True)

    # Seleção com feedback visual + botão "Próxima" para avançar
    # RIT68 (tri_state): Sim / Não / Não se aplica
    resp_atual = st.session_state.respostas.get(codigo)  # 1, 0, "NA" ou None
    is_tri = (not is_filter) and ITEMS.get(codigo, {}).get("tri_state", False)

    if resp_atual is None:
        st.caption("Escolha uma opção (nenhuma selecionada ainda):")
    elif resp_atual == 1:
        st.success("Selecionado: **Sim**")
    elif resp_atual == "NA":
        st.warning("Selecionado: **Não se aplica**")
    else:
        st.info("Selecionado: **Não**")

    if is_tri:
        c1, c2, c3, c4, c5 = st.columns([1, 1, 1.3, 1, 1])
        with c1:
            t_sim = "primary" if resp_atual == 1 else "secondary"
            if st.button("Sim", use_container_width=True, type=t_sim, key=f"sim_{codigo}"):
                st.session_state.respostas[codigo] = 1
                st.rerun()
        with c2:
            t_nao = "primary" if resp_atual == 0 else "secondary"
            if st.button("Não", use_container_width=True, type=t_nao, key=f"nao_{codigo}"):
                st.session_state.respostas[codigo] = 0
                st.rerun()
        with c3:
            t_na = "primary" if resp_atual == "NA" else "secondary"
            if st.button("Não se aplica", use_container_width=True, type=t_na, key=f"na_{codigo}"):
                st.session_state.respostas[codigo] = "NA"
                st.rerun()
        with c4:
            if resp_atual is not None:
                if st.button("Próxima →", use_container_width=True, type="primary", key=f"next_{codigo}"):
                    st.session_state.current_idx += 1
                    st.rerun()
            else:
                st.button("Próxima →", use_container_width=True, disabled=True, key=f"next_dis_{codigo}")
        with c5:
            if st.session_state.current_idx > 0:
                if st.button("⬅️ Voltar", use_container_width=True, key="voltar"):
                    st.session_state.current_idx -= 1
                    st.rerun()
    else:
        col1, col2, col3, col4 = st.columns([1, 1, 1, 1])
        with col1:
            tipo_sim = "primary" if resp_atual == 1 else "secondary"
            if st.button("Sim", use_container_width=True, type=tipo_sim, key=f"sim_{codigo}"):
                st.session_state.respostas[codigo] = 1
                st.rerun()
        with col2:
            tipo_nao = "primary" if resp_atual == 0 else "secondary"
            if st.button("Não", use_container_width=True, type=tipo_nao, key=f"nao_{codigo}"):
                st.session_state.respostas[codigo] = 0
                st.rerun()
        with col3:
            if resp_atual is not None:
                if st.button("Próxima →", use_container_width=True, type="primary", key=f"next_{codigo}"):
                    st.session_state.current_idx += 1
                    st.rerun()
            else:
                st.button("Próxima →", use_container_width=True, disabled=True, key=f"next_dis_{codigo}")
        with col4:
            if st.session_state.current_idx > 0:
                if st.button("⬅️ Voltar", use_container_width=True, key="voltar"):
                    st.session_state.current_idx -= 1
                    st.rerun()

# ============================================================
# RESULTADOS
# ============================================================

if st.session_state.finished:
    escores = calcular_escores(st.session_state.respostas)
    resultado, detalhe = interpretar(escores)
    alertas = gerar_alertas(escores, st.session_state.respostas, resultado)
    citacoes = carregar_citacoes(pasta_citacoes)

    st.success("Avaliação Concluída!")
    st.markdown(f"""
    <div class="result-box">
        <h2 style="margin-top:0; color:#0d47a1;">{resultado}</h2>
        <p style="font-size:1.05rem; line-height:1.5; color:#37474f; margin-bottom:0;">{detalhe.replace(chr(10), '<br/>')}</p>
    </div>
    """, unsafe_allow_html=True)

    # Alertas clínicos
    for al in alertas:
        if al["tipo"] == "urgente":
            cls = "alert-urgente"
        elif al["tipo"] == "severidade":
            cls = "alert-severidade"
        else:
            cls = "alert-comorbidade"
        st.markdown(f"""
        <div class="{cls}">
            <strong>{al['titulo']}</strong><br/>
            {al['texto'].replace(chr(10), '<br/>')}
        </div>
        """, unsafe_allow_html=True)

    c1, c2, c3, c4 = st.columns(4)
    c1.metric("M (Maníaco)", f"{escores['M']}/28")
    c2.metric("D (Depressivo)", f"{escores['D']}/30")
    c3.metric("RIT", f"{escores['RIT']}/14")
    c4.metric("Total (T)", f"{escores['T']}/72")
    st.caption(f"RIT: {faixa_rit(escores['RIT'])}")

    # Travas
    with st.expander("Status das Travas de Prejuízo Funcional"):
        for bloco_id, nome, _ in BLOCOS:
            val = escores["travas"].get(bloco_id)
            if val == 1:
                st.write(f"**{nome}**: ✅ Positiva (Prejuízo Reportado)")
            elif val == 0:
                st.write(f"**{nome}**: ○ Negativa / Não Aplicável")
            else:
                st.write(f"**{nome}**: ⚠ Não Respondida")

    # Bibliografia (se houver)
    if citacoes:
        with st.expander(f"📚 Base bibliográfica ({len(citacoes)} referências)"):
            for i, cit in enumerate(citacoes, 1):
                st.write(f"{i}. {cit}")

    # Gráfico
    st.subheader("📊 Escores por dimensão")
    labels = ["HD", "HM", "ED", "EM", "CD", "CM", "RIT"]
    values = [escores[k] for k in labels]
    maximos = [12, 12, 5, 6, 13, 10, 14]
    fig, ax = plt.subplots(figsize=(10, 4.5))
    bars = ax.bar(
        labels, values,
        color=["#42a5f5", "#ef5350", "#66bb6a", "#ffa726", "#ab47bc", "#26c6da", "#78909c"],
    )
    ax.set_ylim(0, max(maximos) + 2)
    ax.set_ylabel("Pontuação")
    ax.set_title("Escores MOODMETRICS")
    for bar, val, mx in zip(bars, values, maximos):
        ax.text(bar.get_x() + bar.get_width() / 2, bar.get_height() + 0.3,
                f"{val}/{mx}", ha="center", va="bottom", fontsize=9)
    st.pyplot(fig)
    plt.close()

    with st.expander("Ver escores detalhados"):
        st.write(f"""
        - **HD** (Humor Depressivo): {escores['HD']} / 12
        - **HM** (Humor Maníaco): {escores['HM']} / 12
        - **ED** (Energia Depressiva): {escores['ED']} / 5
        - **EM** (Energia Maníaca): {escores['EM']} / 6
        - **CD** (Cognição Depressiva): {escores['CD']} / 13
        - **CM** (Cognição Maníaca): {escores['CM']} / 10
        - **RIT** (Ritmicidade): {escores['RIT']} / 14 → {faixa_rit(escores['RIT'])}
        - **M** = HM+EM+CM: {escores['M']} / 28 (corte ≥ 14)
        - **D** = HD+ED+CD: {escores['D']} / 30 (corte ≥ 17)
        - **T** = M+D+RIT: {escores['T']} / 72
        """)

    st.subheader("📥 Baixar Relatório")
    col_pdf, col_txt = st.columns(2)
    with col_pdf:
        pdf_bytes = gerar_pdf(escores, resultado, detalhe, st.session_state.respostas, citacoes, alertas)
        st.download_button(
            label="📄 Baixar PDF",
            data=pdf_bytes,
            file_name=f"MOODMETRICS_{datetime.now().strftime('%Y%m%d_%H%M%S')}.pdf",
            mime="application/pdf",
            use_container_width=True,
        )
    with col_txt:
        texto_relatorio = f"""MOODMETRICS – Resultado
Data: {datetime.now().strftime('%d/%m/%Y %H:%M')}

RESULTADO: {resultado}
{detalhe}

"""
        if alertas:
            texto_relatorio += "ALERTAS CLÍNICOS:\n"
            for al in alertas:
                texto_relatorio += f"- {al['titulo']}: {al['texto']}\n"
            texto_relatorio += "\n"

        texto_relatorio += f"""Escores:
HD: {escores['HD']}
HM: {escores['HM']}
ED: {escores['ED']}
EM: {escores['EM']}
CD: {escores['CD']}
CM: {escores['CM']}
RIT: {escores['RIT']} → {faixa_rit(escores['RIT'])}
M: {escores['M']}
D: {escores['D']}
T: {escores['T']}

Travas:
"""
        for bloco_id, nome, _ in BLOCOS:
            val = escores["travas"].get(bloco_id)
            status = "POSITIVA" if val == 1 else ("Negativa/N/A" if val == 0 else "Não respondida")
            texto_relatorio += f"{nome}: {status}\n"
        if citacoes:
            texto_relatorio += "\nBase bibliográfica:\n"
            for i, cit in enumerate(citacoes, 1):
                texto_relatorio += f"{i}. {cit}\n"
        texto_relatorio += "\nRespostas:\n"
        for k, v in st.session_state.respostas.items():
            if v == 1:
                txt = "SIM"
            elif v == "NA":
                txt = "N/A (não se aplica)"
            else:
                txt = "NÃO"
            texto_relatorio += f"{k}: {txt}\n"

        st.download_button(
            label="📝 Baixar TXT",
            data=texto_relatorio,
            file_name=f"MOODMETRICS_{datetime.now().strftime('%Y%m%d_%H%M%S')}.txt",
            mime="text/plain",
            use_container_width=True,
        )

    st.divider()
    if st.button("🔄 Nova avaliação", use_container_width=True):
        st.session_state.respostas = {}
        st.session_state.current_idx = 0
        st.session_state.finished = False
        st.session_state.sequencia = construir_sequencia()
        st.rerun()
