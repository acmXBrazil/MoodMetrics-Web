# Caminhos configuráveis (relativos à pasta do app)
BASE_DIR = Path(__file__).parent
ARQUIVO_TEXTOS = BASE_DIR / "textos_diagnosticos.json"
# Pasta de citações (opcional). No ambiente web pode ficar vazia ou apontar para uma pasta relativa.
DEFAULT_CITACOES = BASE_DIR / "citacoes"  # crie a pasta e coloque os .txt se quiser bibliografia

def carregar_textos_diagnosticos() -> dict:
    """Carrega textos estáticos dos diagnósticos a partir do JSON."""
    if ARQUIVO_TEXTOS.exists():
        try:
            with open(ARQUIVO_TEXTOS, encoding="utf-8") as f:
                return json.load(f)
        except Exception:
            pass
    return {}

TEXTOS_DIAGNOSTICOS = carregar_textos_diagnosticos()

def carregar_interferencias() -> dict:
    """Carrega o template de interferências (pergunta | comorbidade | diagnóstico → texto)."""
    # Procura em vários locais possíveis
    candidatos = [
        Path(__file__).parent / "Comorbidades" / "interferencias_template.md",
        Path(__file__).parent.parent / "Comorbidades" / "interferencias_template.md",
    ]
    path = None
    for c in candidatos:
        if c.exists():
            path = c
            break
    if not path:
        return {}
    try:
        texto = path.read_text(encoding="utf-8", errors="ignore")
    except Exception:
        return {}
    interf = {}
    atual = None
    linhas = []
    for linha in texto.splitlines():
        if linha.startswith("## "):
            if atual and linhas:
                interf[atual] = " ".join(linhas).strip()
            partes = [p.strip() for p in linha[3:].split("|")]
            if len(partes) == 3:
                atual = (partes[0], partes[1], partes[2])  # (pergunta, cm, dx)
            else:
                atual = None
            linhas = []
        elif atual and linha.strip() and not linha.startswith("#"):
            linhas.append(linha.strip())
    if atual and linhas:
        interf[atual] = " ".join(linhas).strip()
    return interf


INTERFERENCIAS = carregar_interferencias()

# Mapa de títulos de diagnóstico para códigos DX
DX_MAPA = {
