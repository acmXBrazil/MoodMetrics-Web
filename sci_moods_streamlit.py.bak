    "Depressivo (componente do Espectro Bipolar)": "DX_05",
    "Transtorno Depressivo com Características Mistas e Indícios de Espectro Bipolar": "DX_06",
    "Espectro Afetivo Altamente Instável (Subsindrômico)": "DX_07",
    "Sintomatologia Leve / Inespecífica": "DX_08",
}

def carregar_citacoes(pasta: Path | str | None = None) -> list[str]:
    """Lê arquivos .txt de citação (01.txt, 02.txt...) e retorna lista ordenada."""
    pasta = Path(pasta) if pasta else DEFAULT_CITACOES
    if not pasta.exists() or not pasta.is_dir():
        return []
    citacoes = []
    for p in sorted(pasta.glob("*.txt")):
        try:
            texto = p.read_text(encoding="utf-8", errors="ignore").strip()
        except Exception:
            try:
                texto = p.read_text(encoding="latin-1", errors="ignore").strip()
            except Exception:
                continue
        if texto:
            citacoes.append(texto)
    return citacoes

