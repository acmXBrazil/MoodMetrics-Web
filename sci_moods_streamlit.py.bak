    ("EM", "Energia Maníaca (EM)", ["EM30", "EM31", "EM32", "EM33", "EM34", "EM35"]),
    ("CD", "Cognição Depressiva (CD)", ["CD36", "CD37", "CD38", "CD39", "CD40", "CD41", "CD42", "CD43", "CD44", "CD45", "CD46", "CD47", "CD48"]),
    ("CM", "Cognição Maníaca (CM)", ["CM49", "CM50", "CM51", "CM52", "CM53", "CM54", "CM55", "CM56", "CM57", "CM58"]),
    ("RIT", "Ritmicidade (RIT)", ["RIT59", "RIT60", "RIT61", "RIT62", "RIT63", "RIT64", "RIT65", "RIT66", "RIT67", "RIT68", "RIT69", "RIT70", "RIT71", "RIT72"]),
]

FILTRO_CODIGO = {
    "HD": "FHD",
    "HM": "FHM",
    "ED": "FED",
    "EM": "FEM",
    "CD": "FCD",
    "CM": "FCM",
    "RIT": "FRIT",
}

NOME_BLOCO = {b[0]: b[1] for b in BLOCOS}

# ============================================================
# GERAÇÃO DINÂMICA DO TEXTO DO FILTRO
# ============================================================

def gerar_texto_filtro(bloco: str, respostas: dict) -> str | None:
    """Retorna o texto dinâmico do filtro ou None se nenhum sintoma positivo.

    Regras (proposta do pesquisador):
    - 1 a 3 sintomas → lista todos
    - 4 a 6 sintomas → 3 primeiros + “e outros sintomas”
    - 7 ou mais → formulação genérica
    """
    codigos = next(c for b, _, c in BLOCOS if b == bloco)
    positivos = [ITEMS[c]["label"] for c in codigos if respostas.get(c, 0) == 1]
    n = len(positivos)
    if n == 0:
        return None

    # Nome curto do domínio para a frase genérica
    nome_curto = {
        "HD": "humor depressivo",
        "HM": "humor maníaco",
        "ED": "energia depressiva",
        "EM": "energia maníaca",
        "CD": "cognição depressiva",
        "CM": "cognição maníaca",
        "RIT": "ritmicidade",
    }.get(bloco, NOME_BLOCO.get(bloco, bloco))

    if n <= 3:
        lista = ", ".join(f'"{p}"' for p in positivos)
        return (
            f'Você indicou sentir {lista}, você diria que ficou seriamente '
            f"prejudicado, preocupado ou perturbado pelo que estava acontecendo com você?"
        )
    if n <= 6:
        lista = ", ".join(f'"{p}"' for p in positivos[:3])
        return (
            f'Você indicou sentir {lista} e outros sintomas, você diria que ficou seriamente '
            f"prejudicado, preocupado ou perturbado pelo que estava acontecendo com você?"
        )
    return (
        f"Você relatou vários sintomas de {nome_curto}, diria que ficou seriamente "
        f"prejudicado, preocupado ou perturbado pelo que estava acontecendo com você?"
    )


def construir_sequencia(respostas: dict | None = None) -> list[dict]:
    """
    Constrói a sequência de perguntas + filtros.
    No modo Wizard, os filtros só entram se já houver respostas do bloco
    (ou são inseridos após o bloco quando o usuário chega lá).
    Para a lista completa (modo formulário) usamos placeholders.
    """
    seq = []
    for bloco_id, nome, codigos in BLOCOS:
        for c in codigos:
            seq.append({"tipo": "item", "codigo": c, "bloco": bloco_id, "nome_secao": nome})
        # Placeholder do filtro (será resolvido dinamicamente)
        seq.append({"tipo": "filtro", "codigo": FILTRO_CODIGO[bloco_id], "bloco": bloco_id, "nome_secao": nome})
    return seq


# ============================================================
# CÁLCULO DE ESCORES E INTERPRETAÇÃO
# ============================================================

def calcular_escores(respostas: dict) -> dict:
    HD = sum(respostas.get(k, 0) for k in ["HD01", "HD02", "HD03", "HD04", "HD05", "HD06", "HD07", "HD08", "HD09", "HD10", "HD11", "HD12"])
    HM = sum(respostas.get(k, 0) for k in ["HM13", "HM14", "HM15", "HM16", "HM17", "HM18", "HM19", "HM20", "HM21", "HM22", "HM23", "HM24"])
    ED = sum(respostas.get(k, 0) for k in ["ED25", "ED26", "ED27", "ED28", "ED29"])
    EM = sum(respostas.get(k, 0) for k in ["EM30", "EM31", "EM32", "EM33", "EM34", "EM35"])
    CD = sum(respostas.get(k, 0) for k in ["CD36", "CD37", "CD38", "CD39", "CD40", "CD41", "CD42", "CD43", "CD44", "CD45", "CD46", "CD47", "CD48"])
    CM = sum(respostas.get(k, 0) for k in ["CM49", "CM50", "CM51", "CM52", "CM53", "CM54", "CM55", "CM56", "CM57", "CM58"])
    # RIT68 pode ser 1 (Sim), 0 (Não) ou "NA" (Não se aplica) — só Sim pontua
    def ponto_rit(codigo):
        v = respostas.get(codigo, 0)
        return 1 if v == 1 else 0

    RIT = sum(ponto_rit(k) for k in ["RIT59", "RIT60", "RIT61", "RIT62", "RIT63", "RIT64", "RIT65", "RIT66", "RIT67", "RIT68", "RIT69", "RIT70", "RIT71", "RIT72"])

    M = HM + EM + CM
    D = HD + ED + CD
    T = M + D + RIT

    # Travas (1 = positiva, 0 = negativa, None = não aplicável / não respondida)
    travas = {}
    for bloco_id in ["HD", "HM", "ED", "EM", "CD", "CM", "RIT"]:
        fc = FILTRO_CODIGO[bloco_id]
        if fc in respostas:
            travas[bloco_id] = respostas[fc]
        else:
            # Se nenhum sintoma positivo, trava não se aplica
            codigos = next(c for b, _, c in BLOCOS if b == bloco_id)
            if any(respostas.get(c, 0) == 1 for c in codigos):
                travas[bloco_id] = None  # deveria ter respondido, mas não
            else:
                travas[bloco_id] = 0  # não aplicável → trata como negativa

    return {
        "HD": HD, "HM": HM, "ED": ED, "EM": EM,
        "CD": CD, "CM": CM, "RIT": RIT,
        "M": M, "D": D, "T": T,
        "travas": travas,
    }


def faixa_rit(rit: int) -> str:
    if rit <= 2:
        return "Preservada / Normal"
    if rit <= 4:
        return "Zona de Alerta (padrão comum em unipolares)"
    return "Desregulação Crítica (marcador de espectro bipolar)"


def interpretar(escores: dict) -> tuple[str, str]:
    """
    Retorna (título diagnóstico curto, texto enriquecido + nível de impacto).
    Cortes proporcionais à matriz original de 154 itens.
    """
    M, D, T, RIT = escores["M"], escores["D"], escores["T"], escores["RIT"]
    travas = escores["travas"]

    def trava_positiva(*blocos):
        return any(travas.get(b) == 1 for b in blocos)

    # Classificação dimensional (hierarquia)
    if T < 16:
        titulo = "Saudável / Ruído"
        texto = (
            "Perfil dentro da variabilidade esperada do espectro do humor. "
            "A carga sintomatológica total situa-se abaixo do limiar de elevação significativa, "
            "sem evidência de desregulação dimensional clinicamente relevante no momento da avaliação."
        )
        nivel = "Sem relevância clínica"

    elif M >= 14:
        if RIT >= 5:
            titulo = "BIPOLAR (Espectro Maníaco Ativo com Alta Desregulação Circadiana)"
            texto = (
                "Elevação predominante no polo maníaco/hipomaníaco do espectro do humor "
                "(humor, energia e/ou cognição expansiva), com marcadores adicionais de desregulação "
                "de ritmicidade/ciclos biológicos, frequentemente associados na literatura de espectro "
                "a maior instabilidade do curso. Esse padrão é compatível com ativação do espectro bipolar, "
                "alinhado a abordagens dimensionais que descrevem um contínuo de sintomas maníacos "
                "além das categorias estritas de episódio."
            )
        else:
            titulo = "BIPOLAR (Espectro Maníaco Ativo)"
            texto = (
                "Elevação predominante no polo maníaco/hipomaníaco do espectro do humor "
                "(humor, energia e/ou cognição expansiva). Esse padrão é compatível com ativação "
                "do espectro bipolar, alinhado a abordagens dimensionais que descrevem um contínuo "
                "de sintomas maníacos além das categorias estritas de episódio."
            )
        nivel = "Clínico" if trava_positiva("HM", "EM", "CM", "RIT") else "Espectro / traço (sem prejuízo funcional significativo reportado)"

    elif D >= 17:
        if RIT >= 5 and T >= 40:
            titulo = "Transtorno Depressivo com Características Mistas e Indícios de Espectro Bipolar"
            texto = (
                "Alta carga total no espectro, com depressão e ritmicidade elevadas. "
                "Esse padrão aproxima-se de descrições de estados mistos ou de depressão no espectro bipolar, "
                "em que sintomas de polaridades distintas e instabilidade biológica coexistem ao longo do tempo."
            )
        elif RIT >= 5:
            titulo = "Depressivo (componente do Espectro Bipolar)"
            texto = (
                "Polo depressivo elevado associado a desregulação de ritmicidade. "
                "Na literatura de espectro do humor, a combinação de depressão com instabilidade circadiana/cíclica "
                "é um marcador que orienta atenção à possibilidade de componente bipolar, inclusive em apresentações "
                "que não preenchem mania clássica."
            )
        else:
            titulo = "Depressivo (Espectro Depressivo Unipolar)"
            texto = (
                "Elevação concentrada no polo depressivo (humor, energia e cognição), com ritmicidade relativamente preservada. "
                "O perfil sugere sintomatologia do espectro depressivo com menor indício dimensional de bipolaridade "
                "na presente avaliação."
            )
        nivel = "Clínico" if trava_positiva("HD", "ED", "CD", "RIT") else "Espectro / traço (sem prejuízo funcional significativo reportado)"

    elif M < 14 and D < 17 and RIT >= 5 and T >= 28:
        titulo = "Espectro Afetivo Altamente Instável (Subsindrômico)"
        texto = (
            "Sem fechamento dos polos maníaco ou depressivo nos cortes adotados, porém com ritmicidade elevada "
            "e carga total relevante. Compatível com vulnerabilidade de espectro ou traço de instabilidade "
            "afetivo-circadiana, situação em que instrumentos dimensionais são especialmente informativos."
        )
        nivel = "Clínico" if trava_positiva("RIT") else "Espectro / traço"

    else:
        titulo = "Sintomatologia Leve / Inespecífica"
        texto = (
            "Sintomatologia presente em nível leve ou dispersa, sem atingir os limiares dimensionais "
            "de polo ou de ritmicidade crítica. Recomenda-se interpretar no contexto clínico e longitudinal, "
            "sem equiparar a um transtorno categorial."
        )
        # Verifica se há prejuízo reportado em qualquer trava
        if any(travas.get(b) == 1 for b in ["HD", "HM", "ED", "EM", "CD", "CM", "RIT"]):
            nivel = "Baixo impacto, com prejuízo funcional reportado"
        else:
            nivel = "Baixo impacto"

    paragrafo = f"{texto}\n\nNível de impacto: {nivel}."

    # Sobrescreve com texto estático do JSON se existir
    if titulo in TEXTOS_DIAGNOSTICOS:
        dados = TEXTOS_DIAGNOSTICOS[titulo]
        titulo = dados.get("titulo", titulo)
        texto_json = dados.get("texto", "")
        if texto_json:
            paragrafo = f"{texto_json}\n\nNível de impacto: {nivel}."

    return titulo, paragrafo


def gerar_alertas(escores: dict, respostas: dict, titulo_diagnostico: str = "") -> list[dict]:
    """Gera alertas clínicos prioritários para o relatório médico."""
    alertas = []

    # 1. Desejo de morte / ideação / tentativa (urgência)
    desejo = respostas.get("CD46") == 1
    ideacao = respostas.get("CD47") == 1
    tentativa = respostas.get("CD48") == 1
    if desejo or ideacao or tentativa:
        msgs = []
        if desejo:
            msgs.append("Desejo de morte (CD46)")
        if ideacao:
            msgs.append("Ideação suicida ativa (CD47)")
        if tentativa:
            msgs.append("Tentativa de suicídio relatada (CD48)")
        alertas.append({
            "tipo": "urgente",
            "titulo": "ATENÇÃO MÉDICA URGENTE",
            "texto": " e ".join(msgs) + ". Recomenda-se avaliação clínica imediata de risco. (CVV 188 — 24h)",
        })

    # 2. Severidade elevada (≥ 1,5× o corte ou limiares conservadores)
    severos = []
    if escores["M"] >= 21:
        severos.append(f"Polo maníaco elevado (M = {escores['M']}/28, corte ≥ 14)")
    if escores["D"] >= 25:
        severos.append(f"Polo depressivo elevado (D = {escores['D']}/30, corte ≥ 17)")
    if escores["RIT"] >= 8:
        severos.append(f"Ritmicidade crítica elevada (RIT = {escores['RIT']}/14, corte ≥ 5)")

    if severos:
        alertas.append({
            "tipo": "severidade",
            "titulo": "SEVERIDADE ELEVADA — ATENÇÃO CLÍNICA",
            "texto": "Escores substancialmente acima dos pontos de corte: " + "; ".join(severos) + ".",
        })

    # 3. Comorbidades — só aparecem se cruzarem com o diagnóstico real
    dx_codigo = DX_MAPA.get(titulo_diagnostico, "")
    if dx_codigo and INTERFERENCIAS:
        # Agrupa por comorbidade as interferências que batem com o DX atual
        por_cm = {}
        for (pergunta, cm, dx), texto in INTERFERENCIAS.items():
            if dx == dx_codigo and respostas.get(pergunta) == 1:
                if cm not in por_cm:
                    por_cm[cm] = {"itens": [], "textos": []}
                por_cm[cm]["itens"].append(pergunta)
                por_cm[cm]["textos"].append(texto)

        # Nomes das comorbidades
        cm_nomes = {
            "CM_01": "Uso de Substâncias / Medicamentos (Humor Depressivo)",
            "CM_02": "Uso de Substâncias / Medicamentos (Elevação/Irritabilidade)",
            "CM_03": "Sintomas Ansiosos / Transtorno de Ansiedade Concomitante",
            "CM_04": "Comprometimento Neurocognitivo",
            "CM_05": "Sintomas Paranoides / Ideação Persecutória",
            "CM_06": "Alucinações Auditivas Hostis / Manifestação Psicótica",
            "CM_07": "Alucinações Auditivas Positivas / Psicose Maníaca",
            "CM_08": "Impulsividade / Comportamento de Risco / Substâncias",
            "CM_09": "Redução da Necessidade de Sono (Ativação Maníaca)",
            "CM_10": "Sintomas Físicos Recorrentes / Alterações Sensoriais / Efeitos Adversos",
        }

        for cm, dados in por_cm.items():
            nome = cm_nomes.get(cm, cm)
            itens = ", ".join(dados["itens"])
            sugestao = " ".join(dados["textos"])
            alertas.append({
                "tipo": "comorbidade",
                "titulo": f"COMORBIDADE {cm} — {nome}",
                "texto": f"Impacto em {dx_codigo} : {titulo_diagnostico} (Itens: {itens}).\nSugestão: {sugestao}",
            })

    return alertas


# ============================================================
# GERAÇÃO DE PDF
# ============================================================

def gerar_pdf(escores: dict, resultado: str, detalhe: str, respostas: dict, citacoes: list | None = None, alertas: list | None = None) -> bytes:
    buffer = BytesIO()
    doc = SimpleDocTemplate(
        buffer, pagesize=A4,
        rightMargin=2 * cm, leftMargin=2 * cm,
        topMargin=2 * cm, bottomMargin=2 * cm,
    )
    styles = getSampleStyleSheet()
    styles.add(ParagraphStyle(name="Titulo", fontSize=16, alignment=TA_CENTER, spaceAfter=12, textColor=colors.HexColor("#1f77b4")))
    styles.add(ParagraphStyle(name="Subtitulo", fontSize=11, alignment=TA_CENTER, spaceAfter=20, textColor=colors.grey))
    styles.add(ParagraphStyle(name="Secao", fontSize=12, spaceBefore=14, spaceAfter=8, textColor=colors.HexColor("#0d47a1")))
    styles.add(ParagraphStyle(name="Texto", fontSize=10, spaceAfter=6))
    styles.add(ParagraphStyle(name="Resultado", fontSize=12, alignment=TA_CENTER, spaceBefore=10, spaceAfter=10, textColor=colors.HexColor("#0d47a1")))

    story = []
    story.append(Paragraph("MOODMETRICS", styles["Titulo"]))
    story.append(Paragraph(
        "Instrumento de Avaliação do Espectro do Humor<br/>",
        styles["Subtitulo"],
    ))
    story.append(Paragraph(f"Data da avaliação: {datetime.now().strftime('%d/%m/%Y %H:%M')}", styles["Texto"]))
    story.append(Spacer(1, 12))

    story.append(Paragraph("RESULTADO", styles["Secao"]))
    story.append(Paragraph(f"<b>{resultado}</b>", styles["Resultado"]))
    story.append(Paragraph(detalhe.replace("\n", "<br/>"), styles["Texto"]))
    story.append(Spacer(1, 8))

    # Alertas clínicos prioritários
    if alertas:
        for al in alertas:
            if al["tipo"] == "urgente":
                cor = colors.HexColor("#b71c1c")
                bg = colors.HexColor("#ffcdd2")
            elif al["tipo"] == "severidade":
                cor = colors.HexColor("#e65100")
                bg = colors.HexColor("#fff3e0")
            else:
                cor = colors.HexColor("#2e7d32")
                bg = colors.HexColor("#e8f5e9")
            story.append(Paragraph(
                f"<b>{al['titulo']}</b><br/>{al['texto'].replace(chr(10), '<br/>')}",
                ParagraphStyle(
                    name=f"Alerta_{al['tipo']}_{id(al)}",
                    fontSize=10,
                    textColor=cor,
                    spaceBefore=6,
                    spaceAfter=6,
                    borderPadding=6,
                    backColor=bg,
                ),
            ))
        story.append(Spacer(1, 10))
    else:
        story.append(Spacer(1, 10))

    data = [
        ["Dimensão", "Escore", "Máximo"],
        ["HD – Humor Depressivo", str(escores["HD"]), "12"],
        ["HM – Humor Maníaco", str(escores["HM"]), "12"],
        ["ED – Energia Depressiva", str(escores["ED"]), "5"],
        ["EM – Energia Maníaca", str(escores["EM"]), "6"],
        ["CD – Cognição Depressiva", str(escores["CD"]), "13"],
        ["CM – Cognição Maníaca", str(escores["CM"]), "10"],
        ["RIT – Ritmicidade", f"{escores['RIT']} ({faixa_rit(escores['RIT'])})", "14"],
        ["M = HM + EM + CM", str(escores["M"]), "28 (corte ≥ 14)"],
        ["D = HD + ED + CD", str(escores["D"]), "30 (corte ≥ 17)"],
        ["T = M + D + RIT", str(escores["T"]), "72"],
    ]
    table = Table(data, colWidths=[8 * cm, 5 * cm, 4 * cm])
    table.setStyle(TableStyle([
        ("BACKGROUND", (0, 0), (-1, 0), colors.HexColor("#1f77b4")),
        ("TEXTCOLOR", (0, 0), (-1, 0), colors.white),
        ("ALIGN", (1, 0), (-1, -1), "CENTER"),
        ("FONTNAME", (0, 0), (-1, 0), "Helvetica-Bold"),
        ("FONTSIZE", (0, 0), (-1, -1), 9),
        ("BOTTOMPADDING", (0, 0), (-1, 0), 8),
        ("GRID", (0, 0), (-1, -1), 0.5, colors.grey),
        ("ROWBACKGROUNDS", (0, 1), (-1, -1), [colors.white, colors.HexColor("#e8f4f8")]),
    ]))
    story.append(table)
    story.append(Spacer(1, 16))

    # Status das travas
    story.append(Paragraph("Travas de Prejuízo Funcional", styles["Secao"]))
    for bloco_id, nome, _ in BLOCOS:
        val = escores["travas"].get(bloco_id)
        if val == 1:
            status = '<font color="#c62828"><b>POSITIVA (prejuízo reportado)</b></font>'
        elif val == 0:
            status = '<font color="#2e7d32"><b>Negativa / Não aplicável</b></font>'
        else:
            status = '<font color="#757575">Não respondida</font>'
        story.append(Paragraph(f"<b>{nome}</b>: {status}", styles["Texto"]))

    story.append(Spacer(1, 16))
    story.append(Paragraph("Respostas individuais", styles["Secao"]))

    def fmt_resp(v):
        if v == 1:
            return "SIM"
        if v == "NA":
            return "N/A (não se aplica)"
        return "NÃO"

    for k, v in respostas.items():
        if k.startswith("F"):
            continue
        label = ITEMS.get(k, {}).get("label", k)
        story.append(Paragraph(f"<b>{k}</b> ({label}): {fmt_resp(v)}", styles["Texto"]))

    # Base bibliográfica estática
    if citacoes:
        story.append(Spacer(1, 16))
        story.append(Paragraph("Base bibliográfica", styles["Secao"]))
        story.append(Paragraph(
            "Textos de apoio e referências utilizadas na interpretação dimensional do MOODMETRICS.",
            styles["Texto"],
        ))
        for i, cit in enumerate(citacoes, 1):
            story.append(Paragraph(f"{i}. {cit}", styles["Texto"]))

    story.append(Spacer(1, 20))
    story.append(Paragraph(
        "<i>Este relatório é gerado automaticamente pelo algoritmo MOODMETRICS e não substitui avaliação clínica profissional. "
        "</i>",
        styles["Texto"],
    ))
    doc.build(story)
    buffer.seek(0)
    return buffer.getvalue()


# ============================================================
# INTERFACE STREAMLIT
# ============================================================

